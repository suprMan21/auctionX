{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListPublicSiteBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::am-frontend-prod-904183418667"
    },
    {
      "Sid": "WritePublicSiteObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::am-frontend-prod-904183418667/*"
    },
    {
      "Sid": "InvalidatePublicSite",
      "Effect": "Allow",
      "Action": ["cloudfront:CreateInvalidation", "cloudfront:GetInvalidation"],
      "Resource": "arn:aws:cloudfront::904183418667:distribution/E35K71RCQGYBAW"
    }
  ]
}
