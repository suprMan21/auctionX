{
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.2",
    "stripe": "^20.1.2",
    "uuid": "^13.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "serve": "firebase emulators:start --only functions",
    "deploy:dev": "firebase deploy --only functions --project <DEV_PROJECT_ID>",
    "deploy:staging": "firebase deploy --only functions --project <STAGING_PROJECT_ID>",
    "deploy:prod": "firebase deploy --only functions --project <PROD_PROJECT_ID>",
    "openapi:v1": "tsx src/openapi/generate.ts",
    "test:auctions": "npx tsx src/v1/services/auctions/__tests__/run.ts",
    "test": "npm run test:auctions",
    "seed:auction": "ts-node ./scripts/seedAuction.ts",
    "debug:placeBid": "ts-node ./scripts/debugPlaceBid.ts",
    "postflight": "ts-node ./scripts/postflightGate.ts",
    "gate:preflight": "bash ./scripts/preflight.sh",
    "gate:postflight": "bash ./scripts/postflight.sh"
  },
  "main": "lib/index.js"
}
