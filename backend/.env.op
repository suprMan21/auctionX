# Backend secrets — 1Password template (safe to commit, contains no real secrets)
# Inject via: op run --env-file .env.op --account $(cat ../.op-account) -- tsx watch src/server.ts
# Or run: ../scripts/inject-secrets.sh

NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

SUPABASE_URL=op://AM_Development/Supabase Staging/url
SUPABASE_ANON_KEY=op://AM_Development/Supabase Staging/anon-key
SUPABASE_SERVICE_ROLE_KEY=op://AM_Development/Supabase Staging/service-role-key

AWS_ACCESS_KEY_ID=op://AM_Development/AWS AuctionX Media/access-key-id
AWS_SECRET_ACCESS_KEY=op://AM_Development/AWS AuctionX Media/secret-access-key
AWS_REGION=op://AM_Development/AWS AuctionX Media/region
S3_BUCKET_NAME=op://AM_Development/AWS AuctionX Media/s3-bucket

POSTMARK_SERVER_TOKEN=op://AM_Development/Postmark API/server-token
POSTMARK_FROM_EMAIL=op://AM_Development/Postmark API/from-email

STRIPE_SECRET_KEY=op://AM_Development/Stripe/secret-key
STRIPE_PUBLISHABLE_KEY=op://AM_Development/Stripe/publishable-key
STRIPE_WEBHOOK_SECRET=op://AM_Development/Stripe/webhook-secret

PINATA_JWT=op://AM_Development/Pinata/jwt
PINATA_GATEWAY_URL=op://AM_Development/Pinata/gateway-url

MINTER_PRIVATE_KEY=op://AM_Development/Base Network/minter-private-key
BASE_RPC_URL=op://AM_Development/Base Network/rpc-url
BASE_TESTNET_RPC_URL=op://AM_Development/Base Network/testnet-rpc-url
NFT_CONTRACT_ADDRESS=op://AM_Development/Base Network/nft-contract-address
CHAIN_ID=op://AM_Development/Base Network/chain-id

SETTLE_SECRET=op://AM_Development/App Secrets/settle-secret
