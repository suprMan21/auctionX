# Backend secrets — 1Password template (safe to commit, contains no real secrets)
# Inject via: op run --env-file .env.op --account $(cat ../.op-account) -- tsx watch src/server.ts
# Or run: ../scripts/inject-secrets.sh

NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

SUPABASE_URL=op://AM_Development/Supabase_Staging/url
# Migrated 2026-05-21: legacy eyJ... JWT keys revoked by Supabase's new key
# system. Points at the new sb_publishable_... / sb_secret_... keys.
SUPABASE_ANON_KEY=op://AM_Development/Supabase_Staging/newPublishKey
SUPABASE_SERVICE_ROLE_KEY=op://AM_Development/Supabase_Staging/newSecretKey

AWS_ACCESS_KEY_ID=op://AM_Development/AWS AuctionX Media/access-key-id
AWS_SECRET_ACCESS_KEY=op://AM_Development/AWS AuctionX Media/secret-access-key
AWS_REGION=op://AM_Development/AWS AuctionX Media/region
S3_BUCKET_NAME=op://AM_Development/AWS AuctionX Media/s3-bucket

POSTMARK_SERVER_TOKEN=op://AM_Development/Postmark API/server-token
POSTMARK_FROM_EMAIL=op://AM_Development/Postmark API/from-email

STRIPE_SECRET_KEY=op://AM_Development/Stripe/secret-key
STRIPE_PUBLISHABLE_KEY=op://AM_Development/Stripe/publishable-key
STRIPE_WEBHOOK_SECRET=op://AM_Development/Stripe/webhook-secret
STRIPE_CONNECT_WEBHOOK_SECRET=op://AM_Development/Stripe/AM_Connect

PINATA_JWT=op://AM_Development/Pinata/jwt
PINATA_GATEWAY_URL=op://AM_Development/Pinata/gateway-url

MINTER_PRIVATE_KEY=op://AM_Development/Base Network/minter-private-key
BASE_RPC_URL=op://AM_Development/Base Network/rpc-url
BASE_TESTNET_RPC_URL=op://AM_Development/Base Network/testnet-rpc-url
NFT_CONTRACT_ADDRESS=op://AM_Development/Base Network/nft-contract-address
CHAIN_ID=op://AM_Development/Base Network/chain-id

SETTLE_SECRET=op://AM_Development/App Secrets/settle-secret

# Yoti — S22 (Phase 7A). All 7 op:// items populated 2026-05-30:
#   - sdk-id + PEM live in the sandbox-specific items Boss created
#     (Yoti_stagingSandbox + yoti_stagingSDKKey). Prod creds will land in
#     parallel items (e.g. Yoti_prod + yoti_prodSDKKey) when we go live.
#   - webhook-secret was generated (openssl rand -base64 32) and written
#     directly into 1Password; same value gets registered on Yoti's dashboard
#     webhook config at S22.5
#   - base-url, return-url, yoti-enabled=false, yoti-client-mode=mock all set
# Backend falls back to MockYotiClient when YOTI_CLIENT_MODE != 'live'. User-facing
# surface stays behind FEATURE_YOTI_ENABLED until S22.5 flips staging on.
# Sandbox creds were consolidated 2026-05-30 into a single 1Password item
# `yoti_NewSandbox` containing the SDK ID, attached PEM, and sandbox URL.
# The earlier items (`Yoti_stagingSandbox`, `yoti_stagingSDKKey`,
# `yoti_stagingSDKNew`, `Yoti/sandbox_url`) are superseded.
YOTI_SDK_ID=op://AM_Development/yoti_NewSandbox/sandboxSDKID
YOTI_PEM_KEY=op://AM_Development/yoti_NewSandbox/privateKey.pem
YOTI_WEBHOOK_SECRET=op://AM_Development/Yoti/webhook-secret
YOTI_WEBHOOK_URL=op://AM_Development/Yoti/webhook-url
YOTI_BASE_URL=op://AM_Development/yoti_NewSandbox/sandboxURL
YOTI_RETURN_URL=op://AM_Development/Yoti/return-url
FEATURE_YOTI_ENABLED=op://AM_Development/Features/yoti-enabled
YOTI_CLIENT_MODE=op://AM_Development/Features/yoti-client-mode

# ── S-NFC3 — Tag Management API (rev 2) ─────────────────────────────────────
# Token-fee webhook signing secret. DELIBERATELY SEPARATE from
# STRIPE_WEBHOOK_SECRET (parked marketplace) and STRIPE_CONNECT_WEBHOOK_SECRET
# (parked Connect): a shared secret means a leak of one is a forged event on
# all of them, and would let a parked-marketplace event be replayed at the
# token platform. Create the endpoint in the Stripe dashboard pointed at
#   POST /api/v1/webhooks/stripe-token-fees   (event: payment_intent.succeeded)
# and copy its whsec_... into this item.
STRIPE_TOKEN_FEE_WEBHOOK_SECRET=op://AM_Development/Stripe/token-fee-webhook-secret

# Envelope key for Ownership ID salts (ownership_proofs.salt_enc), 32 bytes
# base64. Losing it means no owner can re-download their Receipt, so it must be
# backed up before any real claim is made in production.
#   openssl rand -base64 32 | op item create --category=password \
#     --title='Ownership Salt Key' --vault=AM_Development 'key[password]=-'
OWNERSHIP_SALT_KEY=op://AM_Development/Ownership Salt Key/key

# HMAC key for to_email_hash in security events (S-NFC3 addendum). If unset the
# field is omitted rather than failing, so a missing key degrades the signal
# without breaking a transfer.
SECURITY_LOG_HMAC_KEY=op://AM_Development/Security/log-hmac-key

# Token list prices, USD cents. Defaults in lib/tokenFees.ts match these.
TRANSFER_FEE_CENTS=250
TOKEN_PRICE_CENTS=1000
REISSUE_FEE_CENTS=1000

# FEATURE_REQUIRE_2FA — MUST stay off until S-2FA (MFA enrollment + AAL2
# step-up) ships. There is no enrollment path anywhere in the product yet, so
# turning this on makes /claim and /transfer/:id/complete unreachable.
FEATURE_REQUIRE_2FA=false

# FEATURE_CAD_PRESENTMENT — off until CAD presentment is confirmed available on
# the Stripe account in use. With it off, every account is charged in USD with
# fx_rate 1. Turning it on without USD_CAD_RATE set still falls back to USD.
FEATURE_CAD_PRESENTMENT=false
# USD_CAD_RATE=1.37

# ── S-NFC3.5 — NTAG 424 DNA SDM chip keys ───────────────────────────────────
# Chip keys are DERIVED (KMS HMAC root -> HKDF), never stored. The backend
# reaches the SDM root ONLY (roles META + FILE). The encoder's admin root
# (application master keys) is deliberately not configurable here.
#
# Staging runs the local provider until Boss provisions KMS:
#   NFC_KEY_PROVIDER=local + NFC_ALLOW_LOCAL_KEYS=true + NFC_LOCAL_SDM_ROOT_KEY.
# After KMS is provisioned: NFC_KEY_PROVIDER=kms, NFC_ALLOW_LOCAL_KEYS=false,
# unset NFC_LOCAL_SDM_ROOT_KEY. The 1Password item below is a Boss action:
#   openssl rand -hex 32 | op item create --category=password \
#     --title='NFC Local Root' --vault=AM_Development 'sdm-key[password]=-'
NFC_KEY_PROVIDER=local
NFC_ALLOW_LOCAL_KEYS=true
NFC_LOCAL_SDM_ROOT_KEY=op://AM_Development/NFC Local Root/sdm-key
NFC_KMS_SDM_KEY_ID=alias/am-tag-sdm-staging
NFC_KMS_REGION=us-east-2
NFC_SDM_KEY_VERSION=1
