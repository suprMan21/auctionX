{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EncoderUserWithMfaOnly",
      "Effect": "Allow",
      "Principal": { "AWS": "arn:aws:iam::904183418667:user/am-tag-encoder" },
      "Action": "sts:AssumeRole",
      "Condition": {
        "Bool": { "aws:MultiFactorAuthPresent": "true" },
        "NumericLessThan": { "aws:MultiFactorAuthAge": "3600" }
      }
    }
  ]
}
