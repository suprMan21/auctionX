# op run --env-file encoder.env.op -- python -m tag_encoder.cli personalise ...
# Secrets resolve at process start and never touch disk. KMS creds come from the
# AWS_PROFILE below (MFA-gated role), NOT from this file.
AWS_PROFILE=am-encoder
AWS_REGION=us-east-2
AM_API_BASE=https://vw7zy9mkyg.us-east-2.awsapprunner.com
SUPABASE_URL=op://AM_Development/Supabase_Staging/url
SUPABASE_ANON_KEY=op://AM_Development/Supabase_Staging/newPublishKey
# Staff (admin/super_admin) account used to precheck + enroll. Point these at the
# 1Password item holding that login.
AM_STAFF_EMAIL="op://AM_Development/AM - Admin account/username"
AM_STAFF_PASSWORD="op://AM_Development/AM - Admin account/password"
AM_TAG_ENCODER_PRINCIPAL=encoder-mac-boss
