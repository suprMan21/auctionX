# Frontend secrets — 1Password template (safe to commit, contains no real secrets)
# Inject via: op run --env-file .env.op --account $(cat ../.op-account) -- vite
# Or run: ../scripts/inject-secrets.sh

VITE_SUPABASE_URL=op://AM_Development/Supabase Staging/url
# Migrated 2026-05-21: legacy eyJ... anon JWT was revoked by Supabase's new key
# system migration. Points at the new sb_publishable_... key.
VITE_SUPABASE_ANON_KEY=op://AM_Development/Supabase Staging/newPublishKey
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=op://AM_Development/Supabase Staging/newPublishKey
# VITE_API_URL intentionally not set here — Vite picks it up from .env.local
# (localhost for `npm run dev`) or .env.production (App Runner for `npm run build`).
# Setting it in .env.op poisoned staging builds with localhost via shell-env precedence.
VITE_AWS_S3_BUCKET=op://AM_Development/AWS AuctionX Media/s3-bucket
VITE_AWS_REGION=op://AM_Development/AWS AuctionX Media/region
VITE_STRIPE_PUBLISHABLE_KEY=op://AM_Development/Stripe/publishable-key
VITE_ENV=development
