<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: no cloud backup or device transfer of app data. The session
     lives in Keystore-encrypted storage that cannot be decrypted on another
     phone, so a restored copy would only break sign-in. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
